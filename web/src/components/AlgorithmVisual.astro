---
const {finding}=Astro.props;
const id='algorithm-'+finding.source;
const gain=Number(finding.value.replace('−','-'));
const plot=finding.visual;
const indexHeight=value=>value/125*120;
const engagementX=value=>87+value/5*178;
---
<figure class="algorithm-visual" data-algorithm-reveal={plot.kind==='index'?'f07':plot.kind==='waffle'?'f10':'bars'}>
<div class="algorithm-stat"><strong>{finding.value}<span>%</span></strong><p>{finding.metric}</p></div>
{plot.kind==='index'&&<svg viewBox="0 0 320 182" role="group" aria-labelledby={id+'-title '+id+'-desc'}>
<title id={id+'-title'}>Engagement increased by 17.7% in the limited-history member group.</title>
<desc id={id+'-desc'}>Relative index: comparison system 100; Profile Relevance 117.7. Both columns start at zero.</desc>
{[0,50,100].map(value=><g class="algorithm-axis"><line x1="36" y1={140-indexHeight(value)} x2="300" y2={140-indexHeight(value)}/><text x="26" y={144-indexHeight(value)} text-anchor="end">{value}</text></g>)}
<rect class="algorithm-baseline" x="64" y={140-indexHeight(100)} width="68" height={indexHeight(100)} fill="#adc5d3"/>
<rect class="algorithm-result" x="204" y={140-indexHeight(100+gain)} width="68" height={indexHeight(100+gain)} fill="#00689d"/>
<text class="algorithm-value" x="98" y={131-indexHeight(100)} text-anchor="middle">100</text>
<text class="algorithm-value" x="238" y={131-indexHeight(100+gain)} text-anchor="middle">{100+gain}</text>
<text class="algorithm-label" x="98" y="160" text-anchor="middle">Comparison</text>
<text class="algorithm-label" x="238" y="160" text-anchor="middle">Profile Relevance</text>
</svg>}
{plot.kind==='segments'&&<svg viewBox="0 0 320 182" role="group" aria-labelledby={id+'-title '+id+'-desc'}>
<title id={id+'-title'}>Engagement gains were largest among daily users.</title>
<desc id={id+'-desc'}>Daily users: 4.07% increase. Weekly users: 3.40%. Monthly users: 1.86%. New members: no statistically significant change. Dashed line: overall increase of 3.52%.</desc>
{[0,2,4].map(value=><g class="algorithm-axis"><line x1={engagementX(value)} y1="24" x2={engagementX(value)} y2="140"/><text x={engagementX(value)} y="158" text-anchor="middle">{value}%</text></g>)}
<line class="algorithm-overall" x1={engagementX(gain)} y1="22" x2={engagementX(gain)} y2="140" stroke="#19486a" stroke-dasharray="3 3"/>
<text class="algorithm-overall-label" x={engagementX(gain)} y="13" text-anchor="middle">Overall {gain}%</text>
{plot.segments.map((row,i)=><g>
<text class="algorithm-label" x="76" y={42+i*29} text-anchor="end">{row.label}</text>
{row.value===null?<text class="algorithm-no-change" x="91" y={42+i*29}>No significant change</text>:<>
<rect x="87" y={30+i*29} width={engagementX(row.value)-87} height="17" fill={['#00689d','#0a97d9','#56c02b'][i]}/>
<text class="algorithm-value" x={engagementX(row.value)+7} y={43+i*29}>+{row.value.toFixed(2)}%</text>
</>}
</g>)}
</svg>}
{plot.kind==='waffle'&&<svg viewBox="0 0 320 182" role="group" aria-labelledby={id+'-title '+id+'-desc'}>
<title id={id+'-title'}>Views of content classified as AI slop fell by 40%.</title>
<desc id={id+'-desc'}>Setting views a few weeks earlier to 100, the reported level is 60. Two grids compare the earlier and reported levels; forty outlined squares show the reduction. These are relative views, not counts of posts.</desc>
{[100,100+gain].map((value,group)=>Array.from({length:100},(_,i)=><rect x={28+group*156+i%10*11} y={22+Math.floor(i/10)*11} width="8" height="8" fill={i<value?(group?'#00689d':'#adc5d3'):'#fff'} stroke={i<value?'none':'#d6a577'} stroke-width="1"/>))}
<text class="algorithm-label" x="82" y="155" text-anchor="middle">Earlier · 100</text>
<text class="algorithm-label" x="238" y="155" text-anchor="middle">Reported · {100+gain}</text>
</svg>}
<figcaption>{plot.caption}</figcaption>
</figure>
