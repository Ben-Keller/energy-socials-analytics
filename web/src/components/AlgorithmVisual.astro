---
const {finding}=Astro.props;
const id='algorithm-'+finding.source;
const plot=finding.visual;
const gain=Number(finding.value);
const engagementX=value=>87+value/5*178;
const formatX=value=>94+value/1600*110;
const frequencyX=value=>87+value/1.5*178;
---
<figure class="algorithm-visual" data-algorithm-reveal="bars">
<div class="algorithm-stat"><strong>{finding.value}<span>{finding.suffix??'%'}</span></strong><p>{finding.metric}</p></div>
{plot.kind==='formats'&&<svg viewBox="0 0 320 182" role="group" aria-labelledby={id+'-title '+id+'-desc'}>
<title id={id+'-title'}>Document carousels lead on impressions; single images lead on comments.</title>
<desc id={id+'-desc'}>Personal-profile benchmark: mean impressions are 1,451 for carousels, 1,187 for single images, 1,045 for text, 718 for polls, 606 for video and 338 for multi-image posts. Comments are listed separately.</desc>
<text class="algorithm-overall-label" x="146" y="13" text-anchor="middle">Impressions</text>
<text class="algorithm-overall-label" x="306" y="13" text-anchor="end">Comments</text>
{[0,800,1600].map(value=><g class="algorithm-axis"><line x1={formatX(value)} y1="22" x2={formatX(value)} y2="154"/><text x={formatX(value)} y="171" text-anchor="middle">{value.toLocaleString('en-GB')}</text></g>)}
{plot.rows.map((row,i)=><g>
<text class="algorithm-label" x="85" y={34+i*23} text-anchor="end">{row.label}</text>
<rect x="94" y={23+i*23} width={formatX(row.impressions)-94} height="15" fill={i===0?'#00689d':i===1?'#0a97d9':'#adc5d3'}/>
<text class="algorithm-value" x={formatX(row.impressions)+5} y={35+i*23}>{Math.round(row.impressions).toLocaleString('en-GB')}</text>
<text class:list={['algorithm-value',{'algorithm-best':row.comments===2.8}]} x="306" y={35+i*23} text-anchor="end">{row.comments.toFixed(2)}</text>
</g>)}
</svg>}
{plot.kind==='segments'&&<svg viewBox="0 0 320 182" role="group" aria-labelledby={id+'-title '+id+'-desc'}>
<title id={id+'-title'}>Engagement gains were largest among daily readers.</title>
<desc id={id+'-desc'}>Reader activity groups: daily users, 4.07% increase; weekly users, 3.40%; monthly users, 1.86%; new members, no statistically significant change. Dashed line: overall increase of 3.52%.</desc>
{[0,2,4].map(value=><g class="algorithm-axis"><line x1={engagementX(value)} y1="24" x2={engagementX(value)} y2="140"/><text x={engagementX(value)} y="158" text-anchor="middle">{value}%</text></g>)}
<line class="algorithm-overall" x1={engagementX(gain)} y1="22" x2={engagementX(gain)} y2="140" stroke="#19486a" stroke-dasharray="3 3"/>
<text class="algorithm-overall-label" x={engagementX(gain)} y="13" text-anchor="middle">Overall {gain}%</text>
{plot.segments.map((row,i)=><g>
<text class="algorithm-label" x="76" y={42+i*29} text-anchor="end">{row.label}</text>
{row.value===null?<text class="algorithm-no-change" x="91" y={42+i*29}>No significant change</text>:<>
<rect x="87" y={30+i*29} width={engagementX(row.value)-87} height="17" fill={['#00689d','#0a97d9','#56c02b'][i]}/>
<text class="algorithm-value" x={engagementX(row.value)+7} y={43+i*29}>+{row.value.toFixed(2)}%</text>
</>}
</g>)}
</svg>}
{plot.kind==='frequency'&&<svg viewBox="0 0 320 182" role="group" aria-labelledby={id+'-title '+id+'-desc'}>
<title id={id+'-title'}>Higher posting frequency was associated with higher engagement rates within accounts.</title>
<desc id={id+'-desc'}>Compared with one-post weeks, 2–5 posts were associated with a 0.23 percentage-point difference, 6–10 with 0.76 points, and 11 or more with 1.40 points. These are observational estimates, not predicted gains for Riad.</desc>
{[0,.5,1,1.5].map(value=><g class="algorithm-axis"><line x1={frequencyX(value)} y1="22" x2={frequencyX(value)} y2="147"/><text x={frequencyX(value)} y="169" text-anchor="middle">{value.toFixed(1)}</text></g>)}
{plot.rows.map((row,i)=><g>
<text class="algorithm-label" x="77" y={37+i*32} text-anchor="end">{row.label}</text>
{row.value===0?<><circle cx="87" cy="32" r="2.5" fill="#526b7a"/><text class="algorithm-no-change" x="96" y="37">Reference</text></>:<>
<rect x="87" y={25+i*32} width={frequencyX(row.value)-87} height="17" fill={i===1?'#00689d':'#adc5d3'}/>
<text class="algorithm-value" x={frequencyX(row.value)+6} y={38+i*32}>+{row.value.toFixed(2)}</text>
</>}
</g>)}
</svg>}
<figcaption>{plot.caption}</figcaption>
</figure>
