---
import research from '../platform-research.json';
import AlgorithmVisual from './AlgorithmVisual.astro';
---
<section class="algorithm-context" aria-labelledby="algorithm-title">
<h2 id="algorithm-title">First: what works on LinkedIn?</h2>
<div class="algorithm-findings">
{research.algorithmFindings.map(finding=><article>
<div class="algorithm-copy">
<h3>{finding.title}</h3>
<p class="algorithm-detail">{finding.detail}</p>
<p class="platform-reference"><a href={research.sources[finding.source].url}>{finding.sourceLabel}</a>{finding.localEvidence&&<><br/>{finding.localEvidence}</>}</p>
</div>
<AlgorithmVisual finding={finding}/>
</article>)}
</div>
</section>
