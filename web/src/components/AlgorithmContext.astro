---
import research from '../platform-research.json';
import AlgorithmVisual from './AlgorithmVisual.astro';
const {base}=Astro.props;
---
<section class="algorithm-context" aria-labelledby="algorithm-title">
<h2 id="algorithm-title">First: what’s in the LinkedIn algorithm?</h2>
<p class="algorithm-lead">Three measured results from LinkedIn’s 2026 ranking tests and product updates.</p>
<div class="algorithm-findings">
{research.algorithmFindings.map(finding=><article>
<h3>{finding.title}</h3>
<AlgorithmVisual finding={finding}/>
<p class="algorithm-detail">{finding.detail}</p>
<p class="platform-reference"><a href={research.sources[finding.source].url}>{finding.sourceLabel}</a></p>
</article>)}
</div>
<p class="platform-reference algorithm-research"><a href={base+'research/'}>Full research and history</a></p>
</section>
