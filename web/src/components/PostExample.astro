---
import {imageAttributes} from '../responsive-images.js';
const {post,takeaways,excerpt,selectionReason}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const paragraphs=post.caption.split(/\n\s*\n/).map(p=>p.trim()).filter(Boolean);
const opening=paragraphs[0].match(/^[\s\S]+?[.!?](?=\s|$)/)?.[0]||paragraphs[0];
const continuation=excerpt||paragraphs[0].slice(opening.length).trim()||paragraphs[1]||'';
const date=new Date(post.date+'T00:00:00Z').toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<article class="post-example">
<div class="linkedin-post">
<div class="post-author"><div class="post-profile"><span class="post-avatar" aria-hidden="true"><svg viewBox="0 0 40 40"><circle cx="20" cy="15" r="7"/><path d="M7 38v-5c0-7 5-11 13-11s13 4 13 11v5"/></svg></span><div><strong>Riad Meddeb</strong><span>Original LinkedIn post</span><time datetime={post.date}>{date} · <svg class="post-globe" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2c4 4 4 8 0 12M8 2c-4 4-4 8 0 12"/></svg></time></div></div><span class="linkedin-badge" aria-label="LinkedIn">in</span></div>
<div class="post-excerpt"><p>{opening}</p><p>{continuation.length>360?continuation.slice(0,360)+'…':continuation}</p><button class="post-see-more" data-post={post.id}>…see full post</button></div>
{post.image&&<button class="post-image-button" data-post={post.id} aria-label="Open the complete post"><img {...imageAttributes(post,base)} alt="Image accompanying this post" loading="lazy" decoding="async"/></button>}
<div class="post-social-counts"><span><span class="reaction-icon" aria-hidden="true">👍</span> {post.reactions} reactions</span><span>{post.comments} {post.comments===1?'comment':'comments'}</span></div><div class="post-card-footer"><button data-post={post.id}>Read full post</button><a href={post.source} target="_blank" rel="noopener noreferrer">View on LinkedIn ↗</a></div>
</div>
<aside class="post-annotation" aria-label="Three takeaways from this post"><p class="example-selection">{selectionReason}</p><h3>3 takeaways</h3><ol>{takeaways.map(t=><li>{t}</li>)}</ol></aside>
</article>
