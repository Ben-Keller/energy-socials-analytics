---
import report from '../report-data.json';
import cases from '../report-cases.json';
import PostExample from '../components/PostExample.astro';
import RecommendationIntro from '../components/RecommendationIntro.astro';
import AlgorithmContext from '../components/AlgorithmContext.astro';
import CampaignActions from '../components/CampaignActions.astro';
import '../report.css';
import '../report-explorers.css';
import '../platform-context.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+'/';
const cooking=report.posts.find(p=>p.date==='2026-03-17'&&p.reactions===140);
const jobs=report.posts.find(p=>p.date==='2026-04-21'&&p.reactions===193);
const personal=report.posts.find(p=>p.date==='2026-04-25'&&p.reactions===63);
const hydrogen=report.posts.find(p=>p.date==='2026-01-19'&&p.reactions===200);
const resource=report.posts.find(p=>p.date==='2025-01-12'&&p.reactions===295);
const finance=report.posts.find(p=>p.date==='2025-07-01'&&p.reactions===118);
const event=report.posts.find(p=>p.date==='2026-04-14'&&p.reactions===95);
const chapters=[['depth','One idea'],['stakes','Data visualization'],['formats','Clear arguments'],['events','Event reporting'],['opportunity','Reader opportunity'],['personal','Personal experience']];
const safe=JSON.stringify({...report,base}).replaceAll('<','\\u003c');
const caseFor=key=>cases.find(c=>c.key===key);
---

<!doctype html><html lang="en"><head><meta charset="utf-8"/><link rel="preload" href="/energy-socials-analytics/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/energy-socials-analytics/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#19486A"/><meta name="description" content="Six recommendations for Riad Meddeb’s LinkedIn account, with interactive charts and post-level evidence."/><title>Riad Meddeb Linkedin analysis</title><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2319486A'/%3E%3Ctext x='16' y='23' text-anchor='middle' fill='white' font-size='22'%3ER%3C/text%3E%3C/svg%3E"/></head>
<body>
<a class="skip-link" href="#depth">Skip to the recommendations</a>
<header class="masthead"><a class="wordmark" href={base} aria-label="Riad Meddeb Linkedin analysis — back to beginning"><span class="report-brand" aria-hidden="true">in</span></a><nav class="view-switch" role="tablist" aria-label="Report views"><button id="report-tab" role="tab" aria-controls="report-panel" aria-selected="true" data-view="report">Report</button><button id="explore-tab" role="tab" aria-controls="explorer-panel" aria-selected="false" data-view="explore" data-online>Explore all data</button></nav></header>
<main id="report-panel" role="tabpanel" aria-labelledby="report-tab">

<section class="report-hero" id="top"><h1>Riad Meddeb Linkedin analysis</h1><AlgorithmContext base={base} /><p class="archive-intro">Riad’s LinkedIn archive spans <strong>16 years</strong> and brings together <strong>5,413 posts and reposts</strong>. Since 2023 alone, it includes <strong>660 original posts</strong>: a substantial body of analysis on energy, finance, technology and development.</p></section>
<section class="primary-explorer" id="report-atlas" data-online aria-label="Interactive post archive"><iframe id="report-explorer" title="Interactive post archive with response map and post previews" src={base+'explore/?embedded=1&report=1'}></iframe></section>
<div class="report-body">

<section class="overview" id="overview">
<div class="exhibit flagship-exhibit timeline-exhibit"><h3>Discussion has grown alongside more detailed writing.</h3><div id="overview-chart" data-label="Discussion has grown alongside more detailed writing."></div></div>

</section>
<section class="chapter" data-tone="light" id="depth"><div class="chapter-inner"><div class="chapter-heading"><span class="chapter-number" aria-hidden="true">01</span><div><h2>{report.recommendations[0].title}</h2></div></div>
<RecommendationIntro index={0} />

<PostExample post={hydrogen} takeaways={caseFor("hydrogen").takeaways} excerpt={caseFor("hydrogen").excerpt} selectionReason={caseFor("hydrogen").selectionReason} />
</div></section>
<section class="chapter" data-tone="dark" id="stakes"><div class="chapter-inner"><div class="chapter-heading"><span class="chapter-number" aria-hidden="true">02</span><div><h2>{report.recommendations[1].title}</h2></div></div>
<RecommendationIntro index={1} />

<PostExample post={cooking} takeaways={caseFor("cooking").takeaways} excerpt={caseFor("cooking").excerpt} selectionReason={caseFor("cooking").selectionReason} />
</div></section>
<section class="chapter" data-tone="light" id="formats"><div class="chapter-inner"><div class="chapter-heading"><span class="chapter-number" aria-hidden="true">03</span><div><h2>{report.recommendations[2].title}</h2></div></div>
<RecommendationIntro index={2} />

<section class="exhibit flagship-exhibit approach-exhibit" id="comments-by-approach" aria-labelledby="approach-comments-title">
<h3 id="approach-comments-title">Arguments and event reports receive four median comments overall; their relative performance varies by topic.</h3>
<p class="overall-comparison">Overall median comments: <strong>4</strong> for 98 arguments · <strong>4</strong> for 79 event reports</p>
<article class="embedded-analysis" id="f11" aria-label="Comments by topic and approach"><div class="figuretext" hidden></div></article>
<p class="chart-source">243 classified captions · one topic and writing approach per post</p>
</section>
<section class="exhibit flagship-exhibit approach-exhibit" id="reactions-by-approach" aria-labelledby="approach-reactions-title">
<h3 id="approach-reactions-title">Event reports lead on median reactions in five of seven topics; arguments lead in access and islands.</h3>
<p class="overall-comparison">Overall median reactions: <strong>66</strong> for 98 arguments · <strong>74</strong> for 79 event reports</p>
<article class="embedded-analysis" id="f10" aria-label="Reactions by topic and approach"><div class="figuretext" hidden></div></article>
<p class="chart-source">243 classified captions · one topic and writing approach per post</p>
</section>

<PostExample post={finance} takeaways={caseFor("finance").takeaways} excerpt={caseFor("finance").excerpt} selectionReason={caseFor("finance").selectionReason} />
</div></section>
<section class="chapter" data-tone="dark" id="events"><div class="chapter-inner"><div class="chapter-heading"><span class="chapter-number" aria-hidden="true">04</span><div><h2>{report.recommendations[3].title}</h2></div></div>
<RecommendationIntro index={3} />

<div class="exhibit flagship-exhibit"><h3>Event reports lead on reactions; arguments and reports share the highest median comments.</h3><article class="embedded-analysis" id="f09" aria-label="Median reactions and comments by writing approach"><div class="figuretext" hidden></div></article><p class="chart-source">243 classified captions · one topic and writing approach per post</p></div>
<PostExample post={event} takeaways={caseFor("event").takeaways} excerpt={caseFor("event").excerpt} selectionReason={caseFor("event").selectionReason} />
</div></section>
<section class="chapter" data-tone="light" id="opportunity"><div class="chapter-inner"><div class="chapter-heading"><span class="chapter-number" aria-hidden="true">05</span><div><h2>{report.recommendations[4].title}</h2></div></div>
<RecommendationIntro index={4} />
<PostExample post={jobs} takeaways={caseFor("jobs").takeaways} excerpt={caseFor("jobs").excerpt} selectionReason={caseFor("jobs").selectionReason} />
</div></section>
<section class="chapter" data-tone="dark" id="personal"><div class="chapter-inner"><div class="chapter-heading"><span class="chapter-number" aria-hidden="true">06</span><div><h2>{report.recommendations[5].title}</h2></div></div>
<RecommendationIntro index={5} />
<div class="exhibit flagship-exhibit"><h3>Nine identified to-camera videos received 114 median reactions; other posts in the same months received 48.</h3><div id="camera-chart" data-label="Identified to-camera videos and other posts published in March–June 2026, by date and reactions."></div></div>
<PostExample post={personal} takeaways={caseFor("personal").takeaways} excerpt={caseFor("personal").excerpt} selectionReason={caseFor("personal").selectionReason} />

</div></section>
<section class="topic-evidence" id="topic-evidence" aria-labelledby="topic-evidence-title"><div class="topic-evidence-inner">
<h2 id="topic-evidence-title">Topic and format comparisons</h2>
<div class="evidence-sequence">
<section class="exhibit flagship-exhibit topic-flow-feature" id="topic-flow" aria-label="How topics become different kinds of posts">
<h3>Arguments and event reports account for 73% of classified captions; opportunity and personal posts account for 7%.</h3>
<article class="embedded-analysis" id="f13" aria-label="How topics become different kinds of posts"><div class="figuretext" hidden></div></article>
<p class="chart-source">243 classified captions · one topic and writing approach per post</p>
</section>
<section class="exhibit flagship-exhibit topic-connection-feature" id="topic-connections" aria-label="Topics that appear together">
<h3>AI, finance and grids form the most frequent connections across the six tracked subjects.</h3>
<div id="network-chart" data-label="Topics that appear together: AI, finance and grids form the most frequent connections."></div>
<p class="chart-source">221 captions with overlapping topic tags · ten most frequent connections</p>
</section>
<section class="exhibit flagship-exhibit" id="evidence-response" aria-label="Topic attention and discussion">
<h3>Six of the seven main topics receive 60–75 median reactions, despite large differences in publishing volume.</h3>
<article class="embedded-analysis" id="f08" aria-label="Topic attention and discussion, with ranked comparisons"><div class="figuretext" hidden></div></article>
<p class="chart-source">243 classified captions · one topic and writing approach per post</p>
</section>
<section class="exhibit flagship-exhibit" id="evidence-distribution" aria-label="Topic distributions beyond the median">
<h3>Within every main topic, the middle 50% spans a wider reaction range than the gap between topic medians.</h3>
<article class="embedded-analysis" id="f23" aria-label="Topic distributions beyond the median"><div class="figuretext" hidden></div></article>
<p class="chart-source">243 classified captions · one topic and writing approach per post</p>
</section>
<section class="exhibit flagship-exhibit" id="evidence-mix" aria-label="Topic mix and share of discussion">
<h3>Response shares broadly follow publishing volume; finance and grids attract a larger share of discussion.</h3>
<article class="embedded-analysis" id="f07" aria-label="Topic mix and share of discussion"><div class="figuretext" hidden></div></article>
<p class="chart-source">243 classified captions · one topic and writing approach per post</p>
</section>
<section class="exhibit flagship-exhibit" id="evidence-media" aria-label="Response by post format">
<h3>Identified to-camera videos lead on relative reactions; figure cards most often receive more comments than comparable image posts.</h3>
<div id="formats-chart" data-label="Response by post format, compared with other image posts in the same quarter."></div>
</section>
</div>
</div></section>
<CampaignActions base={base} />

</div></main>
<section id="explorer-panel" role="tabpanel" aria-labelledby="explore-tab" hidden><iframe id="full-explorer" title="Comprehensive post archive and analysis" data-src={base+'explore/?embedded=1#atlas'}></iframe></section>
<dialog class="records-dialog" id="records-dialog" aria-labelledby="records-title"><div class="records-header"><div><p class="record-count" id="records-scope"></p><h2 id="records-title"></h2></div><button class="dialog-close" aria-label="Close post browser">Close ×</button></div><div class="records-tools"><label>Find a post<input id="records-search" type="search" placeholder="Search these captions…"/></label><label>Sort<select id="records-sort"><option value="reactions">Most reactions</option><option value="comments">Most comments</option><option value="newest">Newest</option></select></label><button class="text-button" id="records-csv">Download selection ↓</button></div><div class="records-layout"><div id="records-list" aria-label="Matching posts"></div><article class="record-detail" id="record-detail"></article></div><div id="records-status" class="sr-only" role="status"></div></dialog>
<div class="chart-tooltip" id="chart-tooltip" role="tooltip" hidden></div><div class="toast" id="toast" role="status" hidden></div>
<noscript><p class="noscript">The report’s messages and six priorities are available above. Enable JavaScript to explore the evidence, or use the full dataset.</p></noscript>
<script id="report-data" type="application/json" is:inline set:html={safe}></script><script>import '../report.js';</script>
</body></html>
